---
interface Props {
  title?: string;
}

const { title = 'okgo 博客' } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        padding: 20px;
      }
      .container {
        max-width: 800px;
        margin: 0 auto;
      }
      nav {
        background: white;
        border-radius: 12px;
        padding: 16px 24px;
        margin-bottom: 24px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
      }
      nav ul {
        display: flex;
        list-style: none;
        gap: 24px;
      }
      nav a {
        color: #333;
        text-decoration: none;
        font-weight: 600;
        transition: color 0.2s;
      }
      nav a:hover {
        color: #667eea;
      }
      main {
        background: white;
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
      }
      footer {
        text-align: center;
        color: white;
        margin-top: 24px;
        opacity: 0.8;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <nav>
        <ul>
          <li><a href="/">首页</a></li>
          <li><a href="/blog">博客</a></li>
          <li><a href="/about">关于</a></li>
        </ul>
      </nav>
      <main>
        <slot />
      </main>
      <footer>
        <p>© 2024 okgo的博客 - 不定期更新心得，分享下业务和技术</p>
      </footer>
    </div>
  </body>
</html>
